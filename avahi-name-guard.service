[Unit]
Description=Restore avahi mDNS host name when it drifts to <host>-N.local
After=avahi-daemon.service
Requisite=avahi-daemon.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/avahi-name-guard
# Adjust limits here if needed (see README)
#Environment=MAX_FIX_PER_HOUR=6
#Environment=SETTLE_SEC=6
